    "section": "data",
    "order": 10,
    "why": {
      "en": "Investigate the history of price changes, Buy Box ownership and seasonal rank movement, and assess product opportunities. Available for Amazon US, UK, DE, FR, JP, CA, IT, ES, IN, MX and BR.",
      "zh": "查看价格变化、Buy Box 归属和季节性排名的历史记录，并评估选品机会。数据涵盖亚马逊美国、英国、德国、法国、日本、加拿大、意大利、西班牙、印度、墨西哥和巴西站。"
    },
    "skills": {
      "keepa": {
        "zh": "查商品的价格、排名、Buy Box 和销量历史，也能查卖家。",
        "en": "Looks up a product's price, rank, Buy Box and sales history, and sellers."
      }
    },
    "prompts": {
      "rank-drop": {
        "zh": "从价格、Buy Box 和库存记录中，找出【ASIN】在美国站排名开始变化的那一天"
      },
      "top-ten": {
        "zh": "把亚马逊美国站【搜索词】的十款畅销商品放进一张表格对比"
      },
      "year-on-year": {
        "zh": "查看【ASIN】在美国站的销量比去年同期高还是低"
      }
    },
    "builds": [
      {
        "on": "@comchatx/cx-schedule",
        "need": "optional",
        "why": {
          "en": "Reviews your products and rivals' on a schedule.",
          "zh": "用于按你定的时间，替你复盘竞品和你的商品。"
        }
      },
      {
        "on": "cx-amazon-seller",
        "need": "optional",
        "why": {
          "en": "Tells cx from the start that you sell on Amazon.",
          "zh": "用于让 cx 从第一条消息起就知道你在亚马逊开店。"
        }
      }
    ],
    "source": {
      "name": "keepa",
      "ownKey": {
        "en": "Usage is billed to your balance. You can also use your own Keepa API Key.",
        "zh": "按用量从余额扣费，也可以使用你自己的 Keepa API Key。"
      }
    },
    "mcp": "keepa"
  },
  "dependencies": {
